# Bu dosyayi kopyalayip adini ".env" yapin ve kendi anahtarinizi yazin.
# Anahtari buradan alabilirsiniz: https://aistudio.google.com  ->  "Get API key"
# .env dosyasi .gitignore icinde oldugu icin GitHub'a YUKLENMEZ.

GEMINI_API_KEY=buraya_kendi_anahtarinizi_yazin

# Istege bagli: modeli degistirmek isterseniz satirin basindaki # isaretini kaldirin.
# GEMINI_MODEL=gemini-3.5-flash-lite        # hizli, varsayilan
# GEMINI_MODEL_OZENLI=gemini-3.6-flash      # "Daha ozenli yaz" acikken
# GEMINI_MODEL_SES=gemini-3.6-flash         # ses -> metin
# GEMINI_OZENLI_ZAMAN_ASIMI_SN=30           # ozenli model bu kadar surede yanit vermezse hizli modele gecilir (en az 10)
# GEMINI_SES_ZAMAN_ASIMI_SN=45              # ses cozumleme icin ayni sinir
